# Konfigurasi Apache/LiteSpeed (Hostinger) untuk frontend React (SPA).
# File ini ikut tersalin ke dist/ saat `npm run build`.

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Paksa HTTPS dan domain tanpa www (satu versi URL untuk SEO)
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\. [NC]
    RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    # Hapus garis miring di akhir URL (/layanan/ -> /layanan)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+)/$ /$1 [L,R=301]

    # sitemap.xml dibuat otomatis oleh backend Laravel (berisi semua artikel terbaru)
    RewriteRule ^sitemap\.xml$ api/sitemap.xml [L]

    # /api/... adalah backend Laravel (symlink ke backend/public), jangan diubah di sini
    RewriteRule ^api(/|$) - [L]

    # /prerender hanya untuk penggunaan internal
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteRule ^prerender(/|$) - [R=404,L]

    # Halaman statis dengan meta SEO hasil build (dist/prerender/*.html)
    RewriteCond %{DOCUMENT_ROOT}/prerender/$1.html -f
    RewriteRule ^(.+)$ prerender/$1.html [L]

    # File/folder yang benar-benar ada dikirim apa adanya
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Semua route lain (mis. /artikel/judul, /admin) diarahkan ke index.html
    RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Aset hasil build Vite memakai hash di nama file (mis. index-C9vvbIyC.js), aman di-cache lama
    <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # HTML jangan di-cache agar versi baru langsung terpakai
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
